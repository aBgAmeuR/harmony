# Application
RUST_LOG=debug
APP_ENV=development

# Server
HOST=127.0.0.1
PORT=3000

# Database
DATABASE_URL=postgres://harmony:harmony@localhost:5432/harmony

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_ATTRIBUTE_COUNT_LIMIT=4096
OTEL_TRACES_SAMPLER=always_on
OTEL_SERVICE_NAME=harmony
OTEL_SERVICE_VERSION=3.0.0

# Object storage (S3-compatible)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=harmony
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Deezer proxy configuration
DEEZER_PROXY_URLS=http://proxy1.example.com,http://proxy2.example.com
DEEZER_PROXY_SECRET=your-secret-here
