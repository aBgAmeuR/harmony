# Application
RUST_LOG=debug
APP_ENV=development

# Every server setting below is optional. Defaults are shown in comments.

# Server
# HOST=127.0.0.1
# PORT=3000

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_ATTRIBUTE_COUNT_LIMIT=4096
OTEL_TRACES_SAMPLER=always_on
OTEL_SERVICE_NAME=harmony
OTEL_SERVICE_VERSION=3.0.0

# Local storage (used when S3_ENDPOINT is not set)
# DuckDB files are written to DATA_DIR/harmony and served on /files/{id}.duckdb.
# DATA_DIR=./data

# S3-compatible storage (optional)
# Setting S3_ENDPOINT enables S3 mode; S3_BUCKET, AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY are then required.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_BUCKET=harmony
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# SigV4 region: "auto" for R2, the real region for AWS, "garage" for Garage.
# S3_REGION=auto
# Public URL where harmony/*.duckdb objects are readable. /files redirects there.
# S3_PUBLIC_URL=https://bucket.example.com/harmony

# Deezer
# Without proxies, Deezer is called directly, capped at DEEZER_RATE_LIMIT
# requests per second (1-50).
# DEEZER_RATE_LIMIT=8
# Setting DEEZER_PROXY_URLS enables proxy mode; DEEZER_PROXY_SECRET is then required.
# DEEZER_PROXY_URLS=https://proxy-1.example.com,https://proxy-2.example.com
# DEEZER_PROXY_SECRET=your-proxy-secret

# Upload
# Maximum ZIP size in megabytes (1-2000).
# MAX_UPLOAD_MB=50
