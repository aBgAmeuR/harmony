# Application
RUST_LOG=debug
APP_ENV=development

# Server
HOST=127.0.0.1
PORT=3000

# Database
DATABASE_URL=postgres://harmony:harmony@localhost:5432/harmony

# DuckDB output directory (one .duckdb file per package)
DUCKDB_DATA_DIR=./data/duckdb

# Deezer proxy configuration
DEEZER_PROXY_URLS=http://proxy1.example.com,http://proxy2.example.com
DEEZER_PROXY_SECRET=your-secret-here
DEEZER_MATCH_THRESHOLD=0.8
DEEZER_REQUEST_GAP_MS=50
DEEZER_MAX_RETRIES=3
DEEZER_RETRY_DELAY_MS=1000
