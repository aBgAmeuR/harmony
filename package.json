{
  "name": "harmony",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo -F web dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "cd apps/server && cargo run --bin server",
    "check:server": "cd apps/server && cargo check",
    "test:server": "cd apps/server && cargo test",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@harmony/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.10.6",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.7.1"
}
