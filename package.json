{
  "name": "harmony",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A batteries-included AdonisJS starter kit for building modern APIs with type-safe frontend integration",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "docker:build:api": "docker build -f docker/api.Dockerfile -t harmony-api:local .",
    "docker:build:web": "docker build -f docker/web.Dockerfile -t harmony-web:local .",
    "docker:build": "npm run docker:build:api && npm run docker:build:web"
  },
  "devDependencies": {
    "@adonisjs/prettier-config": "^1.4.5",
    "prettier": "^3.8.1",
    "turbo": "^2.8.18"
  },
  "packageManager": "npm@11.9.0",
  "prettier": "@adonisjs/prettier-config"
}
