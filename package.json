{
  "name": "harmony",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "dev:web": "turbo run dev --filter=web",
    "dev:server": "cd apps/server && cargo run --bin server",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "oxlint",
    "format:check": "oxfmt --check",
    "format": "oxfmt --write",
    "check": "turbo run //#lint //#format:check",
    "check:server": "cd apps/server && cargo check",
    "check:fmt:server": "cd apps/server && cargo fmt --check",
    "format:server": "cd apps/server && cargo fmt",
    "lint:server": "cd apps/server && cargo clippy --all-targets -- -D warnings",
    "test:server": "cd apps/server && cargo test",
    "verify": "turbo run //#lint //#format:check check-types && pnpm check:fmt:server && pnpm lint:server"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@harmony/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.10.6",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.7.1"
}
