# Harmony works without any setting. Copy this file to .env and uncomment what you need.

# Image tag to run: latest, v3, or an exact release such as v3.0.0-beta.20
# HARMONY_VERSION=latest
# Port published on the host
# HARMONY_PORT=3000

# Maximum upload size in MB
# MAX_UPLOAD_MB=50

# Deezer requests go straight from this server by default, rate-limited per second.
# DEEZER_RATE_LIMIT=8
# Optional proxies to spread Deezer requests (see docs/DEPLOY.md)
# DEEZER_PROXY_URLS=https://proxy-1.example.com,https://proxy-2.example.com
# DEEZER_PROXY_SECRET=change-me

# S3-compatible storage instead of the local volume
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=harmony
# S3_REGION=auto
# S3_PUBLIC_URL=https://files.example.com/harmony
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Logs and telemetry
# RUST_LOG=server=info
# LOG_FORMAT=compact
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
