{
  "name": "@harmony/oxfmt",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./oxfmt.json": "./oxfmt.json"
  },
  "scripts": {
    "format": "cd ../.. && oxfmt -c tooling/oxfmt/oxfmt.json --ignore-path=.gitignore --ignore-path=tooling/oxfmt/ignore --write",
    "check": "cd ../.. && oxfmt -c tooling/oxfmt/oxfmt.json --ignore-path=.gitignore --ignore-path=tooling/oxfmt/ignore --check"
  }
}
